# ThreatLocker API Configuration
# Used when AUTH_MODE=env (stdio / single-tenant). In AUTH_MODE=gateway,
# tool calls never fall back to these variables — send credential headers.
THREATLOCKER_API_KEY=your_api_key_here
THREATLOCKER_ORGANIZATION_ID=your_org_id_here

# Transport Configuration
MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http

# HTTP Transport Configuration (when MCP_TRANSPORT=http)
# Required whenever the HTTP server starts. The process exits non-zero if
# this is empty. The value is never logged. Do not commit a real secret.
CONDUIT_S2S_SECRET=
# Local development only. Starts HTTP without CONDUIT_S2S_SECRET and logs
# a loud warning. Do not set this in production.
# MCP_ALLOW_INSECURE_DEV=1

MCP_HTTP_PORT=8080
# Bind address. When MCP_HTTP_HOST is unset the server binds 127.0.0.1.
# The container image sets MCP_HTTP_HOST=0.0.0.0 explicitly.
MCP_HTTP_HOST=127.0.0.1

# Authentication Mode
# gateway: require per-request vendor credential headers (no env fallback).
# env: read THREATLOCKER_API_KEY from the environment (stdio / single-tenant).
AUTH_MODE=gateway
# AUTH_MODE=env

# Logging
LOG_LEVEL=info